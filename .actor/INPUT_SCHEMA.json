{
  "title": "일본 중고 시계 마켓 — 크로스샵 비교（Jackroad+Kitamura）",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "statsMode": {
      "title": "相場統計モード",
      "type": "boolean",
      "description": "有効にすると通常のデータプッシュを行わず、集計結果のみを出力します",
      "default": false,
      "editor": "checkbox"
    },
    "statsKeyword": {
      "title": "統計用キーワード",
      "type": "string",
      "description": "統計モード時にタイトル部分一致で絞り込むキーワード",
      "editor": "textfield"
    },
    "searchKeyword": {
      "title": "Search Keyword",
      "type": "string",
      "description": "Search keyword",
      "prefill": "ROLEX",
      "editor": "textfield"
    },
    "maxItems": {
      "title": "Max Items",
      "type": "integer",
      "description": "Max items to collect",
      "default": 100,
      "minimum": 1
    },
    "maxPages": {
      "title": "Max Pages",
      "type": "integer",
      "description": "Max pages per source",
      "default": 2,
      "minimum": 1
    },
    "sources": {
      "title": "Sources",
      "type": "string",
      "description": "Comma-separated sources",
      "default": "jackroad,kitamura",
      "editor": "textfield"
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "editor": "proxy",
      "description": "Apify proxy configuration",
      "default": {
        "useApifyProxy": true
      },
      "prefill": {
        "useApifyProxy": true
      }
    }
  },
  "required": []
}
